{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/preparation-briefs",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/meet-artifacts",
      "schedule": "*/30 * * * *"
    }
  ]
}
