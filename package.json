{
  "name": "salesagent-luma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:bant": "tsx --test tests/bant-*.test.ts",
    "db:generate:development": "node scripts/generate-development-client.mjs",
    "test:bant:db": "node scripts/generate-development-client.mjs && node --use-system-ca --import tsx scripts/verify-bant-development-db.mts",
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed-luma.ts",
    "db:seed:dev": "tsx prisma/seed-dev.ts",
    "db:studio": "prisma studio",
    "check:t06": "tsx --tsconfig tsconfig.json scripts/check-t06-bant.mts",
    "check:t08": "tsx --tsconfig tsconfig.json scripts/check-t08-luma-context.mts",
    "check:t09": "tsx --tsconfig tsconfig.json scripts/check-t09-preparation.mts",
    "check:t10": "tsx --tsconfig tsconfig.json scripts/check-t10-preparation.mts",
    "check:t14": "tsx --tsconfig tsconfig.json scripts/check-t14-quote.mts",
    "check:t15": "tsx --tsconfig tsconfig.json scripts/check-t15-deal-page.mts",
    "check:t16": "tsx --tsconfig tsconfig.json scripts/check-t16-meet.mts",
    "check:t17": "tsx --tsconfig tsconfig.json scripts/check-t17-quote-template.mts",
    "test:t01": "node --import tsx --test tests/t01-datetime.test.mjs",
    "test:t01:db": "node scripts/generate-development-client.mjs && node --use-system-ca scripts/verify-t01-development-db.mjs",
    "dev:t01": "node scripts/generate-development-client.mjs && node --use-system-ca scripts/dev-t01.mjs",
    "test:t01:browser": "python3 tests/t01-browser.py",
    "dev:app": "node scripts/generate-development-client.mjs && node scripts/prepare-local-dependencies.mjs && node --use-system-ca scripts/dev-app.mjs",
    "test:t02": "node --test tests/t02-meet.test.mjs",
    "test:t02:db": "node scripts/generate-development-client.mjs && node --use-system-ca scripts/verify-t02-development-db.mjs",
    "test:t02:browser": "python3 tests/t02-browser.py",
    "test:development": "node --import tsx --test tests/*.test.mjs tests/bant-*.test.ts",
    "test:development:browser": "python3 tests/development-app-browser.py",
    "check:development": "tsc -p tsconfig.development-check.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed-luma.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.68",
    "@anthropic-ai/sdk": "^0.32.1",
    "@auth/prisma-adapter": "^2.11.2",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/functions": "^2.0.0",
    "ai": "^6.0.175",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.2",
    "google-auth-library": "^9.15.0",
    "googleapis": "^174.0.1",
    "jose": "^5.9.6",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.469.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^4.77.0",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
