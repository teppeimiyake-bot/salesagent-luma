// ============================================================
// 全社共通ドキュメント（提案書・契約書テンプレ）
// ============================================================
model Document {
  id             String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
