  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  ownerUserId  String?  @map("owner_user_id") // null = 組織全体
  period       String   // 2026-Q2 / 2026-04 などフリーフォーマット
  targetAmount Int      @map("target_amount")
  createdAt    DateTime @default(now()) @map("created_at")

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([period])
  @@index([tenantId])
  @@map("goals")
}

// ============================================================
// 入金管理：スポット案件（請求書送付状況・着金状況）
// 元データ: docs/payment-mgmt/入金管理_spot.csv
// Deal / DealProduct / Company とは顧客名マッチ＋手動FK（nullable）で紐付け。
// 着金金額(amountGross) = 契約金額(amountNet) × 1.1（税込）。検算に利用。
// ============================================================
model InvoiceRecord {
  id            String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  // 顧客名（CSV原文。重複企業の表記ゆれをそのまま保持。照合用は normalizeName で別途）
  customerName  String   @map("customer_name")
  // 任意FK（顧客名マッチで紐付け。未マッチは null のまま）
  companyId     String?  @map("company_id")
  dealId        String?  @map("deal_id")
  dealProductId String?  @map("deal_product_id")

  paymentTiming  PaymentTiming  @default(PREPAID)    @map("payment_timing")    // 前払い/納品後/分割
  contractStatus ContractStatus @default(SIGNED)     @map("contract_status")   // 締結済み/未締結
  invoiceStatus  InvoiceSentStatus @default(NOT_SENT) @map("invoice_status")    // 送付済み/未送付/前金分送付済み
  paymentStatus  PaymentRecvStatus @default(UNCONFIRMED) @map("payment_status") // 確認済み/未確認/前金分確認済み

  deliveryDate  DateTime? @map("delivery_date")      // 納品予定日
  expectedPaymentDate DateTime? @map("expected_payment_date") // 着金見込み日

  // 契約金額(税抜・円)。CSVで空のものは null。
  amountNet     Int?     @map("amount_net")
  // 着金金額(税込・円)。原則 amountNet×1.1 だが、CSV原値を優先保持（端数丸めの差異を温存）。
  amountGross   Int?     @map("amount_gross")

  note          String?  @db.Text
  // 投入シードの冪等キー（CSV由来の安定識別子。重複行を区別するため customerName+amountNet 等で生成）
  sourceKey     String?   @map("source_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealProduct DealProduct? @relation(fields: [dealProductId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([dealId])
  @@index([dealProductId])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@unique([tenantId, sourceKey])
  @@map("invoice_records")
}

enum PaymentTiming {
  PREPAID      // 前払い
  ON_DELIVERY  // 納品後支払い
  INSTALLMENT  // 分割支払い
}

enum ContractStatus {
  SIGNED    // 締結済み
  UNSIGNED  // 未締結
}

enum InvoiceSentStatus {
  SENT            // 送付済み
  NOT_SENT        // 未送付
  PARTIAL_SENT    // 前金分送付済み
}

enum PaymentRecvStatus {
  CONFIRMED          // 確認済み
  UNCONFIRMED        // 未確認
  PARTIAL_CONFIRMED  // 前金分確認済み
}

// ============================================================
// 入金管理：定期（SNS等の月額継続契約）
// 元データ: docs/payment-mgmt/入金管理_recurring.csv
// 月次の請求送付/着金フラグは RecurringBillingPeriod に正規化（40列の生フラグは持たない）。
// ============================================================
model RecurringBilling {
  id            String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  customerName  String   @map("customer_name")
  companyId     String?  @map("company_id")
  dealId        String?  @map("deal_id")
  dealProductId String?  @map("deal_product_id")

  initialFee    Int?     @map("initial_fee")    // 初期費用(円)
  monthlyFee    Int?     @map("monthly_fee")     // 月額(円)
  startDate     DateTime? @map("start_date")     // 契約開始日
  endDate       DateTime? @map("end_date")       // 契約終了日

  note          String?  @db.Text
  sourceKey     String?   @map("source_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealProduct DealProduct? @relation(fields: [dealProductId], references: [id], onDelete: SetNull)
  periods     RecurringBillingPeriod[]

  @@index([companyId])
  @@index([dealId])
  @@index([dealProductId])
  @@unique([tenantId, sourceKey])
  @@map("recurring_billings")
}

// ============================================================
// 定期契約の月次ステータス（請求送付/着金の2フラグ）。
// 1契約 × 対象年月(yyyymm) で一意。グリッドUIのセルに対応。
// ============================================================
model RecurringBillingPeriod {
  id          String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  billingId   String   @map("billing_id")
  // 対象年月。YYYYMM の整数（例 202506）。並び替え・範囲検索が容易。
  yearMonth   Int      @map("year_month")
  sent        Boolean  @default(false)  // 請求送付済み
  paid        Boolean  @default(false)  // 着金確認済み
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  billing RecurringBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@unique([billingId, yearMonth])
  @@index([billingId])
  @@index([yearMonth])
  @@index([tenantId])
  @@map("recurring_billing_periods")
}

// ============================================================
// 受注企業の案件進捗（PMタブ・機能4）
// Notion PMボード「Luma PM-dev」準拠。受注した DealProduct 単位に1件。
// ============================================================
model ProductionProject {
  id            String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  dealId        String   @map("deal_id")
  // 受注商材（DealProduct）に1:1で紐付け。
  dealProductId String?  @unique @map("deal_product_id")
  // 表示/フィルタ用の明示FK。本来は dealProduct->deal->company で辿れるが、SNS等のため明示的に持つ。
  companyId     String?  @map("company_id")
  // 商材カテゴリ（映像/SNS/CATV/アライアンス）。サブタブ分けに使用。
  category      String?
  projectName   String   @map("project_name")
  status        ProductionStatus @default(BEFORE_SHOOT)
  // PM（担当者）。User FK ではなく Notion準拠のテキスト（社外スタッフ名が入ることがある）。
  pmName        String?  @map("pm_name")
  directorName  String?  @map("director_name")  // ディレクター
  cameraName    String?  @map("camera_name")     // カメラ
  editorName    String?  @map("editor_name")     // 編集
  shootDate     DateTime? @map("shoot_date")      // 撮影日
  deliveryDate  DateTime? @map("delivery_date")   // 納品予定日
  // 仮納品予定日（provisional_delivery_date）は 2026-08 に廃止。
  // DB側の列は残置（nullable なので未参照でも支障なし）。
  delivered     Boolean  @default(false)          // 納品済み(チェック)
  note          String?  @db.Text
  // 映像：絵コンテ／香盤表のスプレッドシートURL
  storyboardUrl       String?  @map("storyboard_url")
  shootingScheduleUrl String?  @map("shooting_schedule_url")
  // SNS：総投稿本数（「24本（月4本）」等のテキスト）／提供開始・終了月／管理シートURL
  totalPosts        String?   @map("total_posts")
  serviceStartMonth DateTime? @map("service_start_month")
  serviceEndMonth   DateTime? @map("service_end_month")
  mgmtSheetUrl      String?   @map("mgmt_sheet_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealProduct DealProduct? @relation(fields: [dealProductId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  snsAccounts SnsAccount[]

  @@index([dealId])
  @@index([companyId])
  @@index([category])
  @@index([status])
  @@index([tenantId])
  @@map("production_projects")
}

// 映像/CATV/アライアンスは制作の進行段階、SNSは継続契約なので体系が分かれる。
// UI での出し分けは src/lib/production.ts の statusesForCategory() が持つ。
enum ProductionStatus {
  BEFORE_SHOOT     // 撮影前
  EDITING          // 編集中
  REVISING         // 修正中
  CLIENT_REVIEW    // 先方チェック待ち
  REVISION_WAIT    // 修正待ち
  NEAR_DELIVERY    // 納品間近
  DELIVERED        // 納品済み
  CONTRACTED       // 契約中（SNS）
  CANCELLED        // 解約（SNS）
}

// ============================================================
// SNS媒体別アカウント（PM・SNSカード用）
//   productionProject × platform で一意。password は内部ツール用に平文保存（UIは伏字+トグル）。
//   TODO(security): password は将来 KMS/暗号化カラムへ移行する。
// ============================================================
model SnsAccount {
  id                  String       @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  productionProjectId String       @map("production_project_id")
  platform            SnsPlatform
  accountId           String?      @map("account_id")
  password            String?
  profileUrl          String?      @map("profile_url")
  miyakePcLogin       Boolean      @default(false) @map("miyake_pc_login")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  productionProject ProductionProject @relation(fields: [productionProjectId], references: [id], onDelete: Cascade)

  @@unique([productionProjectId, platform])
  @@index([productionProjectId])
  @@index([tenantId])
  @@map("sns_accounts")
}

enum SnsPlatform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
}

// ============================================================
// MS送付状況（アウトリーチ・アポ獲得KPI）
// 既存の「ms管理」(/ms) とは別物。Lumaのアウトリーチ送付実績を
// ワーカー（送付代行者）× 月内週(1w〜5w) の週次グリッドで管理する。
// ルート: /ms-outreach
// ============================================================

// 送付代行ワーカーのマスタ（既存 User とは紐付けない独立マスタ）
model MsWorker {
  id        String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  // 表示用コード（"001" など。スプレッドシート上の連番に対応。任意）
  code      String?
  name      String   // "フローラ三宮さん" など
  isAgency  Boolean  @default(false) @map("is_agency") // 代理店経由か（社内/個人=false）
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  weeklyEntries MsWeeklyEntry[]

  @@index([tenantId])
  @@map("ms_workers")
}

// 週次実績（ワーカー × 暦年月 × 月内第N週(1〜5)）
// 入力指標は 送信数/アポ数/リスト発注数/問い合わせ発注数 の4つ。
// アポ率(=返信率) は sent/appointments から自動計算（保存しない）。
model MsWeeklyEntry {
  id            String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  workerId      String   @map("worker_id")
  // 暦年・暦月（会計年度ではなく実際の年月）。集計時に lib/config の会計年度ヘルパーで束ねる。
  year          Int
  month         Int      // 1〜12（暦月）
  weekOfMonth   Int      @map("week_of_month") // 月内第N週: 1〜5
  // 入力指標（手入力）
  sent          Int      @default(0) // 送信数
  appointments  Int      @default(0) // アポ数（= 返信数。アポ率/返信率の分子）
  listOrders    Int      @default(0) @map("list_orders")    // リスト発注数
  inquiryOrders Int      @default(0) @map("inquiry_orders") // 問い合わせ発注数
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  worker MsWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, year, month, weekOfMonth])
  @@index([workerId])
  @@index([year, month])
  @@index([tenantId])
  @@map("ms_weekly_entries")
}

// MS送付のKPI目標（会計年度単位）。
// targetReplyRate = 目標返信率(=目標アポ率)。例: 0.005 (=0.50%)。
// 達成率 = 実績アポ率 ÷ targetReplyRate で表示する。
model MsKpiGoal {
  id              String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  // 会計年度の period ラベル（"FY2026"）。組織全体の単一目標。
  period          String
  targetReplyRate Float    @map("target_reply_rate") // 目標返信率(=目標アポ率) 例: 0.005
  // 任意の月次送信数目標など（将来拡張用・現状は返信率のみ運用）
  targetSent      Int?     @map("target_sent")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, period])
  @@map("ms_kpi_goals")
}

// ============================================================
// PMスタッフマスタ（機能4）
// PM管理タブの「PM担当 / ディレクター / カメラ / 編集」プルダウンの選択肢。
// ProductionProject 側は従来どおりテキスト（pmName 等）で値を保持し、
// このマスタは「選択肢の人員リスト」を提供するだけ（FKは張らない）。
// 社外スタッフ名も入り得るため、選択肢に無い名前の手入力も許容する設計。
//   role: "pm" | "director" | "camera" | "editor"
// ============================================================
model PmStaff {
  id        String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  // 役割。1人が複数役割を兼ねる場合は role 別に複数レコードを持つ。
  role      String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([role])
  @@unique([tenantId, role, name])
  @@map("pm_staff")
}
