// 営業AIエージェントSaaS DB schema
generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenant（自社 = 営業主体の法人）
// ------------------------------------------------------------
// 株式会社Luma / 株式会社リージー を1つのDB・1つの管理画面で扱うための
// テナント境界。Luma とリージーは別法人であり、会計年度も異なるため、
// 期間集計に関わる設定はここに持たせる（旧 src/lib/config.ts の定数を置換）。
//
// テナント所有テーブルは tenant_id を持ち、src/lib/db.ts の Prisma Extension が
// 全クエリに自動で tenant_id 条件を注入する（書き漏れによる越境を防ぐ）。
// ============================================================
model Tenant {
  id        String   @id @default(uuid())
  // 内部コード（"luma" | "reagey"）。URL・環境変数・シード等から参照する不変キー
  code      String   @unique
  // 正式名称（株式会社Luma / 株式会社リージー）
  name      String
  // 画面表示用の短縮名（Luma / リージー）
  shortName String   @map("short_name")
  // 会計年度の開始月（1〜12）。Luma=6（5月決算）／リージー=1（12月決算）
  fiscalYearStartMonth Int @default(1) @map("fiscal_year_start_month")
  // テナントごとのテーマ色（HEX）。誤テナント操作を防ぐため画面全体の基調色に使う
  themeColor String? @map("theme_color")
  logoUrl    String? @map("logo_url")
  active     Boolean @default(true)
  sortOrder  Int     @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  userTenants UserTenant[]

  @@map("tenants")
}

// ============================================================
// UserTenant（社員 × テナントの所属と権限）
// ------------------------------------------------------------
// 社長・冨永は Luma / リージー 両方に所属する。権限はテナントごとに異なりうるため
// permission / role は User ではなくこちらを正本とする（User側は互換のため残置）。
// ============================================================
model UserTenant {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tenantId   String   @map("tenant_id")
  // このテナントにおける権限（admin / user / viewer）
  permission String   @default("user")
  // このテナントにおける役職（sales / manager）
  role       String?  @default("sales")
  // ログイン直後に選択される初期テナント（ユーザーごとに1件だけ true）
  isDefault  Boolean  @default(false) @map("is_default")
  // 全社統合ビュー（Luma＋リージー合算）の閲覧可否。原則 admin のみ true
  crossTenantRead Boolean @default(false) @map("cross_tenant_read")
  createdAt  DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

// ============================================================
// User（自社の営業担当）
// ------------------------------------------------------------
// User は テナント横断の共有マスタ（1人が複数テナントに所属しうる）。
// 実効権限は UserTenant を参照すること。User.permission / User.role は
// 移行期の互換のために残置しているが、新規ロジックでは参照しない。
// ============================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // パスワード認証は任意化（Googleログインのみのユーザは null）
  passwordHash String?  @map("password_hash")
  name         String
  // 氏名のフリガナ（カタカナ）。担当者をカタカナ読みでも検索できるようにするための任意フィールド。
  // 例: name="三宅哲平" / nameKana="ミヤケテッペイ"。未設定でも検索は name 部分一致で機能する。
  nameKana     String?  @map("name_kana")
  // NextAuth が使用するプロフィール画像URL（Googleアバターなど）
  image        String?
  emailVerified DateTime? @map("email_verified")
  role         String?  @default("sales")  // sales / manager（チーム上の役職）
  permission   String   @default("user")   // admin / user / viewer（システム上の権限）
  avatarColor  String?  @map("avatar_color")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedDeals       Deal[]            @relation("DealOwner")
  ownedDealProducts DealProduct[]    @relation("DealProductOwner")
  uploadedDocs     Document[]
  chatMessages     ChatMessage[]
  goals            Goal[]
  accounts         Account[]
  sessions         Session[]
  createdQuotes    Quote[]
  userTenants      UserTenant[]

  @@map("users")
}

// ============================================================
// NextAuth: OAuth プロバイダ（Google等）の Account 紐付け
// ============================================================
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ============================================================
// NextAuth: DBセッション
// ============================================================
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// NextAuth: メール検証トークン（将来の magic link 用に確保）
// ============================================================
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// プロダクトマスタ（= カテゴリ。管理者が作成 → 商談で選択）
// 旧: Product.name = プロダクト名 / Product.category = 業界カテゴリ
// 新: Product.name = カテゴリ名（ユーザー視点。例「映像」「SNS」）
// 旧 category フィールドはマイグレ後も残置するが UI からは参照しない
// ============================================================
model Product {
  id          String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  name        String
  category    String?  // 旧フィールド（互換のため残置・UI不参照）
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  plans        ProductPlan[]
  dealProducts DealProduct[]

  @@unique([tenantId, name])
  @@map("products")
}

// ============================================================
// プロダクトプラン（旧 Product.planNames + Product.basePrice をモデル化）
// プラン名・ベース価格・並び順を持つ
// ============================================================
model ProductPlan {
  id          String  @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  productId   String  @map("product_id")
  name        String
  basePrice   Int?    @map("base_price")
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  active      Boolean @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@index([tenantId])
  @@map("product_plans")
}

// ============================================================
// 顧客企業
// ============================================================
model Company {
  id               String   @id @default(uuid())
  name             String
  industry         String?
  websiteUrl       String?  @map("website_url")
  websiteSummary   String?  @db.Text @map("website_summary")
  websiteFetchedAt DateTime? @map("website_fetched_at")
  note             String?  @db.Text
  // 企業基本情報
  address          String?
  ceoName          String?  @map("ceo_name")
  establishedYear  Int?     @map("established_year")
  employeeCount    Int?     @map("employee_count")
  capital          String?
  phoneNumber      String?  @map("phone_number")
  logoColor        String?  @map("logo_color")
  logoUrl          String?  @map("logo_url") // 企業ロゴ画像URL
  // ソフト削除：null = 通常 / Date = ゴミ箱送り（マージによるアーカイブも同じ deletedAt を使う）
  deletedAt        DateTime? @map("deleted_at")
  // 企業マージで統合された場合、統合先（surviving）企業の id。null = 通常
  mergedIntoId     String?  @map("merged_into_id")
  createdAt        DateTime @default(now()) @map("created_at")

  // 営業リストエージェント連携（Phase 3）— agent 由来の追加情報
  contactFormUrl   String?  @map("contact_form_url")            // 問い合わせフォームURL
  doNotContact     Boolean  @default(false) @map("do_not_contact") // 送付禁止 / 明示NG
  source           String?                                       // 取得元媒体（mynavi 等）
  sourceKey        String?  @unique @map("source_key")           // agent由来会社の冪等キー

  // ── マルチテナント ──────────────────────────────────────
  // Company は「テナント所有」ではなく Luma / リージー 共有の企業マスタ。
  // リージーの顧客47社中24社が Luma にも存在し、リージーのリードソースに
  // 「Luma顧客企業」が実在する（=相互送客が実務化している）ため、分離複製せず共有する。
  // createdByTenantId は起票元テナント。一覧のデフォルト絞り込みと監査に使う。
  // （テナント越しの閲覧制御は「自テナントの商談を持つ企業 ∪ 自テナント起票の企業」で行う）
  createdByTenantId String? @map("created_by_tenant_id")

  contacts Contact[]
  deals    Deal[]
  invoiceRecords    InvoiceRecord[]
  recurringBillings RecurringBilling[]
  productionProjects ProductionProject[]

  // 自己参照：統合先企業（surviving）／このcompanyに統合されてきた企業群（mergedChildren）
  mergedInto     Company?  @relation("CompanyMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedChildren Company[] @relation("CompanyMerge")

  @@index([deletedAt])
  @@index([mergedIntoId])
  @@index([createdByTenantId])
  @@map("companies")
}

// ============================================================
// 企業マージ履歴（重複統合の監査ログ＋復元用スナップショット）
// ============================================================
model CompanyMerge {
  id                 String    @id @default(uuid())
  // 統合先（残る企業）
  survivingCompanyId String    @map("surviving_company_id")
  // 統合元（アーカイブされる企業）
  mergedCompanyId    String    @map("merged_company_id")
  // 復元用スナップショット：消えた企業の全カラム＋付け替えた contact_ids / deal_ids ＋ surviving に補完したフィールド
  snapshot           Json
  performedByUserId  String?   @map("performed_by_user_id")
  performedAt        DateTime  @default(now()) @map("performed_at")
  // 復元（undo）した場合の日時。null = 統合が有効
  undoneAt           DateTime? @map("undone_at")

  @@index([survivingCompanyId])
  @@index([mergedCompanyId])
  @@index([undoneAt])
  @@map("company_merges")
}

// ============================================================
// 「別会社」判定の記録（重複候補から除外し再提示しないペア）
// companyIdA < companyIdB にソートして保存し一意制約で重複防止
// ============================================================
model CompanyMergeDismissed {
  id           String   @id @default(uuid())
  companyIdA   String   @map("company_id_a")
  companyIdB   String   @map("company_id_b")
  dismissedById String? @map("dismissed_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([companyIdA, companyIdB])
  @@index([companyIdA])
  @@index([companyIdB])
  @@map("company_merge_dismissed")
}

// ============================================================
// 顧客側担当者（連絡先）
// ============================================================
model Contact {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  role      String?  // 役職
  email     String?
  phone     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  isDecisionMaker Boolean @default(false) @map("is_decision_maker")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("contacts")
}

// ============================================================
// 営業リストエージェント連携：staging（未レビュー成果物の緩衝層）— Phase 3
// エージェントが出した会社候補を貯め、人手レビューで承認したものだけを
// Company/Contact へ正式反映する。CRM に未検証データを混ぜないための層。
// ============================================================
model AgentRun {
  id         String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  source     String   // 取得元媒体（mynavi / rikunabi / ...）
  agentRunId String?  @map("agent_run_id") // Cloud Run 側の run_HHMMSS
  createdAt  DateTime @default(now()) @map("created_at")

  candidates AgentCandidate[]

  @@index([source])
  @@index([tenantId])
  @@map("agent_runs")
}

model AgentCandidate {
  id               String    @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  runId            String    @map("run_id")
  sourceKey        String    @map("source_key") // 冪等キー（媒体+媒体内ID等）
  companyName      String    @map("company_name")
  dedupeKey        String    @map("dedupe_key") // normalizeName(companyName)
  websiteUrl       String?   @map("website_url")
  contactFormUrl   String?   @map("contact_form_url")
  phone            String?
  email            String?
  industry         String?
  address          String?
  // 事前突合（intake 時に既存 Company へ当たれば記録）
  matchedCompanyId String?   @map("matched_company_id")
  matchStatus      String?   @map("match_status") // new / exact / domain / norm
  // レビュー状態：pending / approved / rejected / ingested
  reviewStatus     String    @default("pending") @map("review_status")
  reviewedById     String?   @map("reviewed_by_id")
  reviewedAt       DateTime? @map("reviewed_at")
  ingestedCompanyId String?  @map("ingested_company_id")
  ingestedAt       DateTime? @map("ingested_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  run      AgentRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence AgentEvidence[]
  messages AgentGeneratedMessage[]

  @@index([runId])
  @@index([reviewStatus])
  @@index([dedupeKey])
  @@unique([tenantId, sourceKey])
  @@map("agent_candidates")
}

model AgentEvidence {
  id           String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  candidateId  String   @map("candidate_id")
  evidenceJson Json     @map("evidence_json") // 根拠URL/テキスト
  createdAt    DateTime @default(now()) @map("created_at")

  candidate AgentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([tenantId])
  @@map("agent_evidence")
}

model AgentGeneratedMessage {
  id          String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  candidateId String   @map("candidate_id")
  subject     String?
  body        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  candidate AgentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([tenantId])
  @@map("agent_generated_messages")
}

// ============================================================
// 商談（= 企業単位 / 1企業=1Deal、内部に複数プロダクト DealProduct を持つ）
// ============================================================
model Deal {
  id             String      @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  companyId      String      @map("company_id")
  ownerUserId    String?     @map("owner_user_id")  // Deal全体の主担当（DealProduct単位の担当者は別）
  title          String      // 商談タイトル（自由記述）
  status         DealStatus  @default(LEAD)
  // 商談プロセスステージ（リージー独自運用：商談前/商談後/契約フェーズの細粒度ラベル）
  pipelineStage  String?     @map("pipeline_stage")
  nextAction     String?     @map("next_action")
  nextActionAt   DateTime?   @map("next_action_at")
  // アポ獲得日：商談タイトル「アポ獲得日 + 顧客名 + 担当者名」の自動生成にも使う。
  appointmentDate DateTime?  @map("appointment_date")
  // 商談予定日：アポ獲得後、実際に商談（打ち合わせ）を行う予定日。
  // appointmentDate（=アポ獲得日）とは別軸。ms管理タブのインライン編集対象。
  meetingScheduledAt DateTime? @map("meeting_scheduled_at")
  expectedCloseDate DateTime? @map("expected_close_date")
  // 契約日：DealProductが受注ステータスになった時のクロージング日。
  // KPI実績集計はこの contractDate ベース（×何月度に契約したか）。
  contractDate   DateTime?   @map("contract_date")
  // リード獲得経由（LeadSource マスタへの参照）
  leadSourceId   String?     @map("lead_source_id")
  // リード獲得時のメモ（どう取得したか/きっかけ/紹介者など）
  leadSourceMemo String?     @db.Text @map("lead_source_memo")
  // 案件全体のBANT集約
  bant           Json?
  bantUpdatedAt  DateTime?   @map("bant_updated_at")
  // ソフト削除
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner      User?             @relation("DealOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  leadSource LeadSource?       @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  products   DealProduct[]
  meetings   Meeting[]
  tasks      Task[]
  aiLogs     AiLog[]
  roleplays  RoleplaySession[]
  documents  Document[]
  quotes     Quote[]
  invoiceRecords     InvoiceRecord[]
  recurringBillings  RecurringBilling[]
  productionProjects ProductionProject[]

  @@index([companyId])
  @@index([status])
  @@index([ownerUserId])
  @@index([deletedAt])
  @@index([contractDate])
  @@index([leadSourceId])
  @@index([appointmentDate])
  @@index([tenantId])
  @@map("deals")
}

// ============================================================
