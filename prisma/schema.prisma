// 営業AIエージェントSaaS DB schema
generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User（自社の営業担当）
// ============================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // パスワード認証は任意化（Googleログインのみのユーザは null）
  passwordHash String?  @map("password_hash")
  name         String
  // NextAuth が使用するプロフィール画像URL（Googleアバターなど）
  image        String?
  emailVerified DateTime? @map("email_verified")
  role         String?  @default("sales")  // sales / manager（チーム上の役職）
  permission   String   @default("user")   // admin / user / viewer（システム上の権限）
  avatarColor  String?  @map("avatar_color")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedDeals       Deal[]            @relation("DealOwner")
  ownedDealProducts DealProduct[]    @relation("DealProductOwner")
  uploadedDocs     Document[]
  chatMessages     ChatMessage[]
  goals            Goal[]
  accounts         Account[]
  sessions         Session[]

  @@map("users")
}

// ============================================================
// NextAuth: OAuth プロバイダ（Google等）の Account 紐付け
// ============================================================
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ============================================================
// NextAuth: DBセッション
// ============================================================
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// NextAuth: メール検証トークン（将来の magic link 用に確保）
// ============================================================
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// プロダクトマスタ（= カテゴリ。管理者が作成 → 商談で選択）
// 旧: Product.name = プロダクト名 / Product.category = 業界カテゴリ
// 新: Product.name = カテゴリ名（ユーザー視点。例「映像」「SNS」）
// 旧 category フィールドはマイグレ後も残置するが UI からは参照しない
// ============================================================
model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String?  // 旧フィールド（互換のため残置・UI不参照）
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  plans        ProductPlan[]
  dealProducts DealProduct[]

  @@map("products")
}

// ============================================================
// プロダクトプラン（旧 Product.planNames + Product.basePrice をモデル化）
// プラン名・ベース価格・並び順を持つ
// ============================================================
model ProductPlan {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  name        String
  basePrice   Int?    @map("base_price")
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  active      Boolean @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@map("product_plans")
}

// ============================================================
// 顧客企業
// ============================================================
model Company {
  id               String   @id @default(uuid())
  name             String
  industry         String?
  websiteUrl       String?  @map("website_url")
  websiteSummary   String?  @db.Text @map("website_summary")
  websiteFetchedAt DateTime? @map("website_fetched_at")
  note             String?  @db.Text
  // 企業基本情報
  address          String?
  ceoName          String?  @map("ceo_name")
  establishedYear  Int?     @map("established_year")
  employeeCount    Int?     @map("employee_count")
  capital          String?
  phoneNumber      String?  @map("phone_number")
  logoColor        String?  @map("logo_color")
  logoUrl          String?  @map("logo_url") // 企業ロゴ画像URL
  // ソフト削除：null = 通常 / Date = ゴミ箱送り（マージによるアーカイブも同じ deletedAt を使う）
  deletedAt        DateTime? @map("deleted_at")
  // 企業マージで統合された場合、統合先（surviving）企業の id。null = 通常
  mergedIntoId     String?  @map("merged_into_id")
  createdAt        DateTime @default(now()) @map("created_at")

  contacts Contact[]
  deals    Deal[]
  invoiceRecords    InvoiceRecord[]
  recurringBillings RecurringBilling[]
  productionProjects ProductionProject[]

  // 自己参照：統合先企業（surviving）／このcompanyに統合されてきた企業群（mergedChildren）
  mergedInto     Company?  @relation("CompanyMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedChildren Company[] @relation("CompanyMerge")

  @@index([deletedAt])
  @@index([mergedIntoId])
  @@map("companies")
}

// ============================================================
// 企業マージ履歴（重複統合の監査ログ＋復元用スナップショット）
// ============================================================
model CompanyMerge {
  id                 String    @id @default(uuid())
  // 統合先（残る企業）
  survivingCompanyId String    @map("surviving_company_id")
  // 統合元（アーカイブされる企業）
  mergedCompanyId    String    @map("merged_company_id")
  // 復元用スナップショット：消えた企業の全カラム＋付け替えた contact_ids / deal_ids ＋ surviving に補完したフィールド
  snapshot           Json
  performedByUserId  String?   @map("performed_by_user_id")
  performedAt        DateTime  @default(now()) @map("performed_at")
  // 復元（undo）した場合の日時。null = 統合が有効
  undoneAt           DateTime? @map("undone_at")

  @@index([survivingCompanyId])
  @@index([mergedCompanyId])
  @@index([undoneAt])
  @@map("company_merges")
}

// ============================================================
// 「別会社」判定の記録（重複候補から除外し再提示しないペア）
// companyIdA < companyIdB にソートして保存し一意制約で重複防止
// ============================================================
model CompanyMergeDismissed {
  id           String   @id @default(uuid())
  companyIdA   String   @map("company_id_a")
  companyIdB   String   @map("company_id_b")
  dismissedById String? @map("dismissed_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([companyIdA, companyIdB])
  @@index([companyIdA])
  @@index([companyIdB])
  @@map("company_merge_dismissed")
}

// ============================================================
// 顧客側担当者（連絡先）
// ============================================================
model Contact {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  role      String?  // 役職
  email     String?
  phone     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  isDecisionMaker Boolean @default(false) @map("is_decision_maker")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("contacts")
}

// ============================================================
// 商談（= 企業単位 / 1企業=1Deal、内部に複数プロダクト DealProduct を持つ）
// ============================================================
model Deal {
  id             String      @id @default(uuid())
  companyId      String      @map("company_id")
  ownerUserId    String?     @map("owner_user_id")  // Deal全体の主担当（DealProduct単位の担当者は別）
  title          String      // 商談タイトル（自由記述）
  status         DealStatus  @default(LEAD)
  // 商談プロセスステージ（リージー独自運用：商談前/商談後/契約フェーズの細粒度ラベル）
  pipelineStage  String?     @map("pipeline_stage")
  nextAction     String?     @map("next_action")
  nextActionAt   DateTime?   @map("next_action_at")
  // アポ獲得日：商談タイトル「アポ獲得日 + 顧客名 + 担当者名」の自動生成にも使う。
  appointmentDate DateTime?  @map("appointment_date")
  // 商談予定日：アポ獲得後、実際に商談（打ち合わせ）を行う予定日。
  // appointmentDate（=アポ獲得日）とは別軸。ms管理タブのインライン編集対象。
  meetingScheduledAt DateTime? @map("meeting_scheduled_at")
  expectedCloseDate DateTime? @map("expected_close_date")
  // 契約日：DealProductが受注ステータスになった時のクロージング日。
  // KPI実績集計はこの contractDate ベース（×何月度に契約したか）。
  contractDate   DateTime?   @map("contract_date")
  // リード獲得経由（LeadSource マスタへの参照）
  leadSourceId   String?     @map("lead_source_id")
  // リード獲得時のメモ（どう取得したか/きっかけ/紹介者など）
  leadSourceMemo String?     @db.Text @map("lead_source_memo")
  // 案件全体のBANT集約
  bant           Json?
  bantUpdatedAt  DateTime?   @map("bant_updated_at")
  // ソフト削除
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner      User?             @relation("DealOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  leadSource LeadSource?       @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  products   DealProduct[]
  meetings   Meeting[]
  tasks      Task[]
  aiLogs     AiLog[]
  roleplays  RoleplaySession[]
  documents  Document[]
  invoiceRecords     InvoiceRecord[]
  recurringBillings  RecurringBilling[]
  productionProjects ProductionProject[]

  @@index([companyId])
  @@index([status])
  @@index([ownerUserId])
  @@index([deletedAt])
  @@index([contractDate])
  @@index([leadSourceId])
  @@index([appointmentDate])
  @@map("deals")
}

// ============================================================
// 商談プロセスステージマスタ（管理者がCRUD → 商談新規/詳細で選択）
// Deal.pipelineStage は value 文字列で保管（FKではないため、ステージ削除時もDealデータ保全）
// ============================================================
model PipelineStage {
  id        String   @id @default(uuid())
  value     String   @unique // DBに保管される内部キー（ラベル兼用）
  label     String   // UI表示
  group     String   // before / after / contract
  badgeBg   String   @map("badge_bg")   // Tailwind class（例 bg-emerald-100）
  badgeText String   @map("badge_text") // Tailwind class（例 text-emerald-800）
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([group, sortOrder])
  @@map("pipeline_stages")
}

// ============================================================
// 企画提案マスタ（Luma映像案件で提案する企画の型。例「【採用】ドラマ風動画」）
// 管理者がCRUD・並べ替え → 映像プランの DealProduct でマルチセレクト
// DealProduct.planProposals は name 文字列の配列で保管（FKではない＝マスタ削除しても商談データ保全）
// ============================================================
model PlanProposal {
  id           String   @id @default(uuid())
  name         String   @unique
  color        String   @default("default") // Notion multi_select 色名（blue / brown / orange ...）
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([displayOrder])
  @@map("plan_proposals")
}

// ============================================================
// リード獲得経由マスタ（管理者が編集 → 商談新規/詳細で選択）
// ============================================================
model LeadSource {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  deals Deal[]

  @@map("lead_sources")
}

// ============================================================
// DealProduct（1Dealに複数のプロダクト提案を内包）
// ============================================================
model DealProduct {
  id           String   @id @default(uuid())
  dealId       String   @map("deal_id")
  productId    String?  @map("product_id")  // Productマスタへの参照（nullable）
  productName  String   @map("product_name") // キャッシュ表示用
  planName     String?  @map("plan_name")
  // 映像プランで提案する企画の型（PlanProposal.name の配列。映像カテゴリ以外は空のまま）
  planProposals String[] @default([]) @map("plan_proposals")
  probability  Int      @default(0)
  amount       Int?     // 提案金額（円）
  yomiStatus   String?  @map("yomi_status")  // 受注/Aヨミ/Bヨミ/Cヨミ/ネタ/NG
  ownerUserId  String?  @map("owner_user_id")  // プロダクトごとに担当者が違う場合
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner   User?    @relation("DealProductOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  invoiceRecords    InvoiceRecord[]
  recurringBillings RecurringBilling[]
  productionProject ProductionProject?

  @@index([dealId])
  @@index([productId])
  @@index([ownerUserId])
  @@map("deal_products")
}

enum DealStatus {
  LEAD
  HEARING
  PROPOSAL
  NEGOTIATION
  CLOSING
  WON
  LOST
}

// ============================================================
// 商談ミーティング（議事録 = 要約 + 録画文字起こし）
// ============================================================
model Meeting {
  id            String   @id @default(uuid())
  dealId        String   @map("deal_id")
  meetingDate   DateTime @default(now()) @map("meeting_date")
  // 商談回ラベル（「第3回 役員レビュー」など。未指定時は通し番号で自動生成）
  title         String?
  // minutes = 商談要約（議事録の本体・人間+AI）
  minutes       String?  @db.Text
  // transcript = 録画から自動文字起こし（AI入力源）
  transcript    String?  @db.Text
  recordingUrl  String?  @map("recording_url")
  summary       String?  @db.Text
  issues        Json?
  bantBudget    String?  @map("bant_budget")
  bantAuthority String?  @map("bant_authority")
  bantNeed      String?  @map("bant_need")
  bantTimeline  String?  @map("bant_timeline")
  structured    Json?
  analysis      Json?
  topSales      Json?    @map("top_sales")
  strategy      Json?
  nextActions   Json?    @map("next_actions")
  scores        Json?
  meta          Json?
  createdAt     DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("meetings")
}

// ============================================================
// ToDo
// ============================================================
model Task {
  id              String     @id @default(uuid())
  dealId          String     @map("deal_id")
  title           String
  description     String?    @db.Text
  status          TaskStatus @default(OPEN)
  priority        String?
  impact          String?
  dueDate         DateTime?  @map("due_date")
  isAiGenerated   Boolean    @default(false) @map("is_ai_generated")
  reason          String?    @db.Text
  expectedOutcome String?    @db.Text @map("expected_outcome")
  createdAt       DateTime   @default(now()) @map("created_at")
  completedAt     DateTime?  @map("completed_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([status])
  @@map("tasks")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  SKIPPED
}

// ============================================================
// 全社共通ドキュメント（提案書・契約書テンプレ）
// ============================================================
model Document {
  id             String   @id @default(uuid())
  name           String
  category       String   // proposal / contract / case_study / template / quote / other
  // file = アップロード実体（fileUrl=ストレージURL） / url = 外部リンクのみ（fileUrl=外部URL）
  sourceType     String   @default("file") @map("source_type")
  scope          String   @default("global") // global / deal
  dealId         String?  @map("deal_id")
  description    String?  @db.Text
  // 見積書バージョン（"v1", "v2.1" など。quote 用）
  version        String?
  fileUrl        String   @map("file_url")
  fileSize       Int?     @map("file_size")
  mimeType       String?  @map("mime_type")
  uploadedById   String?  @map("uploaded_by_id")
  // ナレッジ検索用
  tags           String[] // 業界・課題タグ
  embedding      Float[]  // OpenAI embeddings (text-embedding-3-small=1536d) — 任意
  createdAt      DateTime @default(now()) @map("created_at")

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deal       Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([scope])
  @@index([dealId])
  @@map("documents")
}

// ============================================================
// AIエージェントとのチャット履歴
// ============================================================
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  scope     String   // global / deal:<id>
  role      String   // user / assistant / system
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@map("chat_messages")
}

// ============================================================
// AIロープレセッション
// ============================================================
model RoleplaySession {
  id          String   @id @default(uuid())
  dealId      String   @map("deal_id")
  level       Int      @default(2) // 1=初級 / 2=中級 / 3=上級
  personaName String?  @map("persona_name") // 顧客アバター用
  personaRole String?  @map("persona_role")
  scenario    String   @db.Text
  log         Json     // 会話ログ
  feedback    Json?    // AIによる商談後フィードバック
  createdAt   DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("roleplay_sessions")
}

// ============================================================
// 学習用：AI入出力とユーザー編集差分
// ============================================================
model AiLog {
  id        String   @id @default(uuid())
  dealId    String   @map("deal_id")
  step      String
  input     Json
  output    Json
  userEdit  Json?    @map("user_edit")
  createdAt DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([step])
  @@map("ai_logs")
}

// ============================================================
// 招待トークン（admin がメール宛にURLを発行 → /register?invite=token から登録）
// ============================================================
model Invite {
  id           String    @id @default(uuid())
  email        String
  token        String    @unique
  name         String?
  role         String    @default("sales")  // sales / manager
  permission   String    @default("user")   // admin / user / viewer
  invitedById  String?   @map("invited_by_id")
  expiresAt    DateTime  @map("expires_at")
  used         Boolean   @default(false)
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@map("invites")
}

// ============================================================
// 受注目標（個人 / 組織）
// ============================================================
model Goal {
  id           String   @id @default(uuid())
  ownerUserId  String?  @map("owner_user_id") // null = 組織全体
  period       String   // 2026-Q2 / 2026-04 などフリーフォーマット
  targetAmount Int      @map("target_amount")
  createdAt    DateTime @default(now()) @map("created_at")

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([period])
  @@map("goals")
}

// ============================================================
// 入金管理：スポット案件（請求書送付状況・着金状況）
// 元データ: docs/payment-mgmt/入金管理_spot.csv
// Deal / DealProduct / Company とは顧客名マッチ＋手動FK（nullable）で紐付け。
// 着金金額(amountGross) = 契約金額(amountNet) × 1.1（税込）。検算に利用。
// ============================================================
model InvoiceRecord {
  id            String   @id @default(uuid())
  // 顧客名（CSV原文。重複企業の表記ゆれをそのまま保持。照合用は normalizeName で別途）
  customerName  String   @map("customer_name")
  // 任意FK（顧客名マッチで紐付け。未マッチは null のまま）
  companyId     String?  @map("company_id")
  dealId        String?  @map("deal_id")
  dealProductId String?  @map("deal_product_id")

  paymentTiming  PaymentTiming  @default(PREPAID)    @map("payment_timing")    // 前払い/納品後/分割
  contractStatus ContractStatus @default(SIGNED)     @map("contract_status")   // 締結済み/未締結
  invoiceStatus  InvoiceSentStatus @default(NOT_SENT) @map("invoice_status")    // 送付済み/未送付/前金分送付済み
  paymentStatus  PaymentRecvStatus @default(UNCONFIRMED) @map("payment_status") // 確認済み/未確認/前金分確認済み

  deliveryDate  DateTime? @map("delivery_date")      // 納品予定日
  expectedPaymentDate DateTime? @map("expected_payment_date") // 着金見込み日

  // 契約金額(税抜・円)。CSVで空のものは null。
  amountNet     Int?     @map("amount_net")
  // 着金金額(税込・円)。原則 amountNet×1.1 だが、CSV原値を優先保持（端数丸めの差異を温存）。
  amountGross   Int?     @map("amount_gross")

  note          String?  @db.Text
  // 投入シードの冪等キー（CSV由来の安定識別子。重複行を区別するため customerName+amountNet 等で生成）
  sourceKey     String?  @unique @map("source_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealProduct DealProduct? @relation(fields: [dealProductId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([dealId])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@map("invoice_records")
}

enum PaymentTiming {
  PREPAID      // 前払い
  ON_DELIVERY  // 納品後支払い
  INSTALLMENT  // 分割支払い
}

enum ContractStatus {
  SIGNED    // 締結済み
  UNSIGNED  // 未締結
}

enum InvoiceSentStatus {
  SENT            // 送付済み
  NOT_SENT        // 未送付
  PARTIAL_SENT    // 前金分送付済み
}

enum PaymentRecvStatus {
  CONFIRMED          // 確認済み
  UNCONFIRMED        // 未確認
  PARTIAL_CONFIRMED  // 前金分確認済み
}

// ============================================================
// 入金管理：定期（SNS等の月額継続契約）
// 元データ: docs/payment-mgmt/入金管理_recurring.csv
// 月次の請求送付/着金フラグは RecurringBillingPeriod に正規化（40列の生フラグは持たない）。
// ============================================================
model RecurringBilling {
  id            String   @id @default(uuid())
  customerName  String   @map("customer_name")
  companyId     String?  @map("company_id")
  dealId        String?  @map("deal_id")
  dealProductId String?  @map("deal_product_id")

  initialFee    Int?     @map("initial_fee")    // 初期費用(円)
  monthlyFee    Int?     @map("monthly_fee")     // 月額(円)
  startDate     DateTime? @map("start_date")     // 契約開始日
  endDate       DateTime? @map("end_date")       // 契約終了日

  note          String?  @db.Text
  sourceKey     String?  @unique @map("source_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealProduct DealProduct? @relation(fields: [dealProductId], references: [id], onDelete: SetNull)
  periods     RecurringBillingPeriod[]

  @@index([companyId])
  @@index([dealId])
  @@map("recurring_billings")
}

// ============================================================
// 定期契約の月次ステータス（請求送付/着金の2フラグ）。
// 1契約 × 対象年月(yyyymm) で一意。グリッドUIのセルに対応。
// ============================================================
model RecurringBillingPeriod {
  id          String   @id @default(uuid())
  billingId   String   @map("billing_id")
  // 対象年月。YYYYMM の整数（例 202506）。並び替え・範囲検索が容易。
  yearMonth   Int      @map("year_month")
  sent        Boolean  @default(false)  // 請求送付済み
  paid        Boolean  @default(false)  // 着金確認済み
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  billing RecurringBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@unique([billingId, yearMonth])
  @@index([billingId])
  @@index([yearMonth])
  @@map("recurring_billing_periods")
}

// ============================================================
// 受注企業の案件進捗（PMタブ・機能4）
// Notion PMボード「Luma PM-dev」準拠。受注した DealProduct 単位に1件。
// ============================================================
model ProductionProject {
  id            String   @id @default(uuid())
  dealId        String   @map("deal_id")
  // 受注商材（DealProduct）に1:1で紐付け。
  dealProductId String?  @unique @map("deal_product_id")
  // 表示/フィルタ用の明示FK。本来は dealProduct->deal->company で辿れるが、SNS等のため明示的に持つ。
  companyId     String?  @map("company_id")
  // 商材カテゴリ（映像/SNS/CATV/アライアンス）。サブタブ分けに使用。
  category      String?
  projectName   String   @map("project_name")
  status        ProductionStatus @default(BEFORE_SHOOT)
  // PM（担当者）。User FK ではなく Notion準拠のテキスト（社外スタッフ名が入ることがある）。
  pmName        String?  @map("pm_name")
  directorName  String?  @map("director_name")  // ディレクター
  cameraName    String?  @map("camera_name")     // カメラ
  editorName    String?  @map("editor_name")     // 編集
  shootDate     DateTime? @map("shoot_date")      // 撮影日
  deliveryDate  DateTime? @map("delivery_date")   // 納品予定日
  provisionalDeliveryDate DateTime? @map("provisional_delivery_date") // 仮納品予定日
  delivered     Boolean  @default(false)          // 納品済み(チェック)
  note          String?  @db.Text
  // 映像：絵コンテ／香盤表のスプレッドシートURL
  storyboardUrl       String?  @map("storyboard_url")
  shootingScheduleUrl String?  @map("shooting_schedule_url")
  // SNS：総投稿本数（「24本（月4本）」等のテキスト）／提供開始・終了月／管理シートURL
  totalPosts        String?   @map("total_posts")
  serviceStartMonth DateTime? @map("service_start_month")
  serviceEndMonth   DateTime? @map("service_end_month")
  mgmtSheetUrl      String?   @map("mgmt_sheet_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealProduct DealProduct? @relation(fields: [dealProductId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  snsAccounts SnsAccount[]

  @@index([dealId])
  @@index([companyId])
  @@index([category])
  @@index([status])
  @@map("production_projects")
}

enum ProductionStatus {
  BEFORE_SHOOT     // 撮影前
  EDITING          // 編集中
  REVISING         // 修正中
  CLIENT_REVIEW    // 先方チェック待ち
  REVISION_WAIT    // 修正待ち
  NEAR_DELIVERY    // 納品間近
  DELIVERED        // 納品済み
}

// ============================================================
// SNS媒体別アカウント（PM・SNSカード用）
//   productionProject × platform で一意。password は内部ツール用に平文保存（UIは伏字+トグル）。
//   TODO(security): password は将来 KMS/暗号化カラムへ移行する。
// ============================================================
model SnsAccount {
  id                  String       @id @default(uuid())
  productionProjectId String       @map("production_project_id")
  platform            SnsPlatform
  accountId           String?      @map("account_id")
  password            String?
  profileUrl          String?      @map("profile_url")
  miyakePcLogin       Boolean      @default(false) @map("miyake_pc_login")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  productionProject ProductionProject @relation(fields: [productionProjectId], references: [id], onDelete: Cascade)

  @@unique([productionProjectId, platform])
  @@index([productionProjectId])
  @@map("sns_accounts")
}

enum SnsPlatform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
}
