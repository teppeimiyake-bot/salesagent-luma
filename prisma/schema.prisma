  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  name           String
  category       String   // proposal / contract / case_study / template / quote / other
  // file = アップロード実体（fileUrl=ストレージURL） / url = 外部リンクのみ（fileUrl=外部URL）
  sourceType     String   @default("file") @map("source_type")
  scope          String   @default("global") // global / deal
  dealId         String?  @map("deal_id")
  // 自動生成物の状態（quote/contract）：draft = 確定前ドラフト / final = 確定済み発行物。
  // 手動アップロード（既存）は null のまま（= 状態管理対象外）。
  status         String?
  // 自動生成の出所となった DealProduct（quote/contract の差込元）。手動アップロードは null。
  dealProductId  String?  @map("deal_product_id")
  description    String?  @db.Text
  // 見積書バージョン（"v1", "v2.1" など。quote 用）
  version        String?
  fileUrl        String   @map("file_url")
  fileSize       Int?     @map("file_size")
  mimeType       String?  @map("mime_type")
  uploadedById   String?  @map("uploaded_by_id")
  // ナレッジ検索用
  tags           String[] // 業界・課題タグ
  embedding      Float[]  // OpenAI embeddings (text-embedding-3-small=1536d) — 任意
  createdAt      DateTime @default(now()) @map("created_at")

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deal       Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([scope])
  @@index([dealId])
  @@index([dealProductId])
  @@index([tenantId])
  @@map("documents")
}

// ============================================================
// 見積書（機能①）：構造化された見積ヘッダ＋明細。
//   PDF再生成・金額再計算のために docx をそのまま貼らず、明細をモデル化して保持する。
//   1商談で複数の見積（プラン/企画案ごと）を持てる。確定すると Document(category=quote) を
//   発行（fileUrl=生成PDFのストレージキー、Document.dealProductId で紐付け）。
// ============================================================
model Quote {
  id            String   @id @default(uuid())
  // マルチテナント: 所有会社（tenants.id）。Prismaリレーションは張らず FK は SQL 側で担保。
  // @default("") は「型の上では省略可・実際に省略したら FK 違反で落ちる」ための仕掛け:
  // 値は src/lib/db.ts の Prisma Extension が必ず注入する。Extension を通らない経路で
  // 作成すると "" のまま INSERT され、tenants への FK 制約で確実に失敗する（fail-closed）。
  tenantId  String   @default("") @map("tenant_id")
  dealId        String   @map("deal_id")
  // 見積の出所 DealProduct（プラン/企画案）。任意（手組みの見積も許容）。
  dealProductId String?  @map("deal_product_id")
  // 宛名（Company.name を既定でコピー、手修正可）と敬称（御中/様）
  clientName    String   @map("client_name")
  clientHonorific String @default("御中") @map("client_honorific")
  // 委託業務名（タイトル下の件名）
  subject       String?
  // 発行日（和暦表示はPDF側で整形）
  issueDate     DateTime @default(now()) @map("issue_date")
  // 見積有効期限などの備考
  note          String?  @db.Text
  // 消費税率（パーセント。既定10）
  taxRate       Int      @default(10) @map("tax_rate")
  // 確定状態：draft / final。final になると発行 Document を持つ。
  status        String   @default("draft")
  // バージョン表記（"v1" 等。Document.version と揃える）
  version       String?
  // 発行済み PDF Document への参照（final時にセット）
  documentId    String?  @map("document_id")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealProduct DealProduct? @relation(fields: [dealProductId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       QuoteLine[]

  @@index([dealId])
  @@index([dealProductId])
  @@index([tenantId])
  @@map("quotes")
}

