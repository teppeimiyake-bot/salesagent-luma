# ============================================================
# Re;easy Sales Agent for Luma — 環境変数テンプレート
# ============================================================
# このファイルはリポジトリにコミットされる。実値は絶対に書かないこと。
# 本番値は Vercel ダッシュボード → Settings → Environment Variables で設定。
# ローカル開発時は本ファイルを `.env` にコピーして実値を入れる（.envはgit除外済み）。
# ============================================================

# ====== DB (Required) ======
# Local:  postgresql://postgres:<pwd>@localhost:5432/salesagent_luma?schema=public
# Neon:   Vercel Marketplace で Neon を統合すると自動で設定される
#         pooler URL を使う場合は ?sslmode=require&pgbouncer=true&connection_limit=1 を付与
DATABASE_URL="postgresql://user:password@localhost:5432/salesagent_luma?schema=public"

# ====== Auth (Required) ======
# 32文字以上の安全なランダム文字列。本番は `openssl rand -hex 32` で生成。
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# NextAuth(Auth.js) 用。未設定時は JWT_SECRET にフォールバック。本番は別値推奨。
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ============================================================
# AI プロバイダ（フェーズ1完了済み：Gemini）
# ============================================================
# AI_PROVIDER:
#   - "gemini"   : Vercel AI SDK + Google Gemini（本番）
#   - "anthropic": Anthropic SDK 直叩き（旧実装、緊急ロールバック用）
# 未設定 or 不正値 → "gemini"
AI_PROVIDER="gemini"

# Google AI Studio で発行（https://aistudio.google.com/apikey）
# 空のままなら7段推論等は決定論フォールバックで動作する。本番は必須設定。
GOOGLE_GENERATIVE_AI_API_KEY=""

# Gemini モデル設定（任意。未設定時は下記がデフォルト）
GEMINI_MODEL_DEFAULT="gemini-2.5-flash-lite"
GEMINI_MODEL_HEAVY="gemini-2.5-pro"
GEMINI_MODEL_TRANSCRIBE="gemini-2.5-flash-lite"
GEMINI_MODEL_EMBED="gemini-embedding-001"

# ============================================================
# 旧プロバイダ（フォールバック用に残置・コメントアウト）
# AI_PROVIDER=anthropic にしたとき / 緊急時の切戻し用
# ============================================================
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-6"
# OPENAI_API_KEY=""
# OPENAI_TRANSCRIBE_MODEL="whisper-1"
# OPENAI_EMBED_MODEL="text-embedding-3-small"

# ============================================================
# ファイル保存先（フェーズ2-A：Vercel Blob 対応）
# ============================================================
# Vercel Blob トークン（Vercel Marketplace で Blob を統合すると自動セット）
# 値が設定されていれば Vercel Blob、空ならローカル ./uploads/ に保存（dev fallback）
BLOB_READ_WRITE_TOKEN=""

# ローカル開発時のアップロード保存先（BLOB_READ_WRITE_TOKEN 未設定時のみ使用）
UPLOAD_DIR="./uploads"

# ============================================================
# NextAuth (Auth.js) — Googleログイン（招待制／本番は使わない方針）
# ============================================================
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud Console で発行
# 未設定時は Google ログインボタンが UI から非表示になる
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# NextAuth がコールバックURLを構築するときに使う
# Local: http://localhost:3003
# Prod:  https://<your-vercel-domain>.vercel.app
NEXTAUTH_URL="http://localhost:3003"

# ============================================================
# Notion 連携（Lumaヨミ表DB取り込み用 / 一時利用）
# ============================================================
# 取り込み済みなので本番では不要。ローカル再取り込み時のみ設定。
NOTION_API_KEY=""
NOTION_LUMA_YOMI_DB_ID=""

# ============================================================
# 営業リスト作成エージェント（Cloud Run）連携 — Phase 2
# ============================================================
# サイドバー「エージェント」→ /agent ページで iframe 表示する先URL。
# 未設定なら /agent は「URL未設定」の案内を表示する（機能に影響なし）。
# Local: Cloud Run を proxy 経由で開く場合は http://localhost:8080
#        （別ターミナルで: gcloud run services proxy sales-agent --region asia-northeast1）
#        ※ Luma をローカル(http://localhost:3003)で動かす前提。デプロイ済みHTTPSからは
#          http://localhost は mixed-content でブロックされるため、Prod は https URL を使う。
# Prod:  到達可能な https URL（IAP等）を Vercel の Environment Variables に設定
NEXT_PUBLIC_AGENT_URL="http://localhost:8080"
