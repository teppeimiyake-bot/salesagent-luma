# This image is exclusively for the Luma verification service in the authorized shared GCP project.
# Build context must be generated by prepare-cloud-development.mjs.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1 LUMA_DEPLOYMENT_ENV=development
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --legacy-peer-deps --no-audit --no-fund
COPY . .
# No application credentials or live database are needed during the build.
RUN DATABASE_URL=postgresql://offline:offline@127.0.0.1:1/offline \
    CHECKPOINT_DISABLE=1 node node_modules/prisma/build/index.js generate
RUN DATABASE_URL=postgresql://offline:offline@127.0.0.1:1/offline \
    JWT_SECRET=build-only-not-a-runtime-secret-00000000 \
    NODE_OPTIONS=--max-old-space-size=6144 TENANT_STRICT=1 npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
# ffmpeg/ffprobe: T04/T22 long recordings and videos are normalized to speech audio and split
# into 10-minute segments for Vertex. No npm dependency is added.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/src/lib/pdf/fonts ./src/lib/pdf/fonts
COPY --from=builder --chown=node:node /app/cloud-development-runtime.mjs ./
RUN mkdir /app/uploads && chown node:node /app/uploads
USER node
EXPOSE 8080
CMD ["node", "cloud-development-runtime.mjs"]
